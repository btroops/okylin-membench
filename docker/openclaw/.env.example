# OpenClaw 容器环境变量示例 —— 复制为 .env 后填入真实值（.env 含密钥，已被 .gitignore 忽略）

# 镜像（默认官方 GHCR 镜像）
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# 网关端口（宿主机:容器，默认都是 18789）
OPENCLAW_GATEWAY_PORT=18789

# 网关访问令牌（shim 调用 CLI 时需一致）
OPENCLAW_GATEWAY_TOKEN=membench-dev-token

# ---- LLM 后端（GATING ITEM）：Anthropic 兼容端点 ----
# 把 ANTHROPIC_BASE_URL 指向任意兼容服务（如 DeepSeek / 自建网关 / 本地代理），
# 并用 ANTHROPIC_AUTH_TOKEN 提供鉴权；ANTHROPIC_MODEL 指定默认模型。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
# 三档模型映射（可选，未设则回落到 ANTHROPIC_MODEL）
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# 也可改用 OpenAI 兼容 provider（配方 B，N+26；与 Anthropic 组按需二选一）
# 把 OPENAI_BASE_URL 指向任意 OpenAI Chat Completions 兼容端点（含版本段 /v1）。
# 端点需支持 /v1/embeddings 时，memory-core 的语义检索才会启用（否则降级关键词）。
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash
